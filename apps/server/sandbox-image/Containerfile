# The base image of every Sandbox (docs/internals/sandboxes.md, «Base image»): Debian, Node, git,
# ripgrep, common build tools, the AI CLIs of the providers T3 Code runs, and the T3 server of the
# Hub's own version, plus the document skills and the office tools they run (LibreOffice, Poppler,
# pandoc, Tesseract, their Python and Node libraries). `t3 sandbox image build` (or Settings →
# Environments) prepares the context and builds it with rootless Podman 3.4 or newer; nothing here
# needs BuildKit.
#
# The context the Hub prepares:
#   clis/     the providers' CLIs: package.json and its package-lock.json (this directory's clis/),
#             only those two files.
#   office/   the document skills' libraries: package.json, package-lock.json and requirements.txt
#             (Python, with hashes), only those three files.
#   skills/   the document skills (this directory's skills/), installed for every provider.
#   server/   the T3 server of the Hub's version, without its node_modules: the release tree a
#             `t3` executable runs from, or a bundle built from a checkout (`dist/bin.mjs`).
#   modules/  that server's runtime node_modules, for Linux on this machine's architecture.
#   extras/   files laid out under /opt/t3 (a checkout's dev Replay agent); may be empty.
#
# Everything is pinned: Node by version and SHASUMS256, the CLIs with their whole dependency tree
# by clis/package-lock.json (with integrity hashes), the office libraries by office/'s lockfiles
# (Debian's packages, as above, come from bookworm). How to bump each: docs/internals/sandboxes.md.

FROM docker.io/library/debian:bookworm-slim

# Node of the repository's `engines` (package.json).
ARG NODE_VERSION=26.12.1

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NODE_PATH=/opt/t3/office/node_modules \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    T3CODE_SERVER_BROWSER_SANDBOX=0

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash build-essential ca-certificates curl file git git-lfs jq less libatomic1 \
      openssh-client pkg-config procps python3 ripgrep unzip xz-utils zip \
 && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) node_arch=x64 ;; \
      arm64) node_arch=arm64 ;; \
      *) echo "No Node build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    file="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${file}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" | grep " ${file}\$" | sha256sum -c -; \
    tar -xJf "${file}" -C /usr/local --strip-components=1 --no-same-owner \
      --exclude='*/CHANGELOG.md' --exclude='*/README.md' --exclude='*/LICENSE' --exclude='*/doc'; \
    rm "${file}"; \
    node --version; npm --version

# The tools and libraries the document skills (skills/) run, which they say are preinstalled:
# LibreOffice without its GUI (conversions, recalculating formulas) from bookworm-backports, since
# bookworm's 7.4 aborts headless in the xlsx skill's recalculation macro, Poppler and qpdf (PDF pages),
# pandoc, Tesseract with English and Spanish (OCR), and fonts metric-compatible with Office's
# (Liberation for Arial and Times, Carlito for Calibri, Caladea for Cambria) so documents keep their
# layout. Python's are installed system-wide from office/requirements.txt, every file checked by its
# hash; PIP_BREAK_SYSTEM_PACKAGES lets an agent's own `pip install` fall back to ~/.local. Node's
# are office/package-lock.json, none with an install script; NODE_PATH lets `require` find them.
RUN echo "deb http://deb.debian.org/debian bookworm-backports main" \
      > /etc/apt/sources.list.d/bookworm-backports.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends -t bookworm-backports \
      libreoffice-calc-nogui libreoffice-impress-nogui libreoffice-writer-nogui \
 && apt-get install -y --no-install-recommends \
      pandoc poppler-utils qpdf tesseract-ocr tesseract-ocr-spa python3-pip python-is-python3 \
      fonts-crosextra-caladea fonts-crosextra-carlito fonts-dejavu-core fonts-liberation2 fonts-noto-core \
 && rm -rf /var/lib/apt/lists/*
COPY office/package.json office/package-lock.json office/requirements.txt /opt/t3/office/
RUN set -eu; \
    cd /opt/t3/office; \
    pip install --no-cache-dir --no-deps --require-hashes --only-binary=:all: -r requirements.txt; \
    npm ci --omit=dev --ignore-scripts --no-audit --no-fund; \
    npm cache clean --force; rm -rf /root/.npm /root/.cache; \
    soffice --version; pandoc --version | head -n 1; pdftoppm -v; qpdf --version | head -n 1; \
    tesseract --list-langs; markitdown --help > /dev/null; \
    python -c "import docx, openpyxl, pandas, pdfplumber, pypdf, pptx, reportlab"; \
    node -e "require('docx'); require('pptxgenjs'); require('sharp')"

# The libraries and fonts of T3's browser (the agent's preview_* tools, HTML previews), the ones
# `t3 browser setup` installs on a host (PreviewBrowserHost.DEBIAN_PACKAGES): nobody in a Sandbox has
# root to run it. The browser itself downloads into the home on first use, pinned by the server.
# Chrome's own sandbox needs namespaces this container's dropped capabilities do not allow, and the
# container already is the boundary (its Space's agent runs anything in it), so
# T3CODE_SERVER_BROWSER_SANDBOX=0 above turns it off.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libnss3 libglib2.0-0 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 libdbus-1-3 libx11-6 \
      libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 libxkbcommon0 libgbm1 \
      libasound2 libexpat1 fontconfig fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

# The document skills, for every provider: Claude Code reads its managed skills from
# /etc/claude-code/.claude/skills whatever its config dir; Codex, OpenCode and Pi read ~/.agents/skills
# and Grok ~/.grok/skills, which the Sandbox's start links to these (the home is a volume).
COPY skills/ /opt/t3/skills/
RUN mkdir -p /etc/claude-code/.claude && ln -s /opt/t3/skills /etc/claude-code/.claude/skills

# The CLIs from the lockfile, every package checked against its integrity hash, with no install
# script run. Then only the two whose postinstall is needed, rebuilt by name: Claude Code and
# OpenCode ship a placeholder `bin` that their postinstall replaces with the platform binary of
# their (locked, already verified) optional dependency; neither downloads anything. Grok's
# postinstall only copies its binary into the installing user's ~/.grok, and its `bin` launches
# the locked platform binary without it; protobufjs's only checks its version; @google/genai's
# (Pi's) is an `echo`. Codex and Pi have no install script. clis/package.json's `allowScripts`
# allows those two and denies the rest, as npm 12 requires (npm refuses `--allow-scripts` on a
# project's `rebuild`). Only the two files are copied: nothing else of that directory gets in.
#
# npm treats a failed download of an OPTIONAL package (the platform binaries of Claude Code, Codex,
# OpenCode and Grok) as «skip it»: `npm ci` still exits 0, and the build would fail only later at
# `--version`, with a misleading message. So the network gets generous retries and timeouts, and the
# install is repeated (up to 3 times) until every locked optional package that applies to this
# build's platform (os linux, this CPU, glibc or no libc field) is present in node_modules; if not,
# the step fails here and says which. The list comes from the lockfile, so nothing is kept by hand.
# The lockfile's integrity hashes and --ignore-scripts stay in force on every attempt.
ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    NPM_CONFIG_FETCH_TIMEOUT=600000
COPY clis/package.json clis/package-lock.json /opt/t3/clis/
RUN set -eu; \
    cd /opt/t3/clis; \
    missing_optional='const l = require("./package-lock.json").packages, fs = require("fs"); const m = Object.entries(l).filter(([k, v]) => k && v.optional && (v.os || []).includes("linux") && (v.cpu || []).includes(process.arch) && (!v.libc || v.libc.includes("glibc")) && !fs.existsSync(k + "/package.json")).map(([k]) => k.replace(/^node_modules\//, "")); if (m.length) { console.error("Missing optional native packages after npm ci: " + m.join(", ")); process.exit(1); }'; \
    attempt=1; \
    until npm ci --omit=dev --ignore-scripts --no-audit --no-fund && node -e "$missing_optional"; do \
      if [ "$attempt" -ge 3 ]; then echo "npm ci did not install every native optional package after $attempt attempts (a download failed; check the network)" >&2; exit 1; fi; \
      attempt=$((attempt + 1)); echo "Retrying npm ci (attempt $attempt of 3)" >&2; rm -rf node_modules; \
    done; \
    npm rebuild --foreground-scripts @anthropic-ai/claude-code opencode-ai; \
    for bin in claude codex opencode pi grok; do ln -s "/opt/t3/clis/node_modules/.bin/${bin}" "/usr/local/bin/${bin}"; done; \
    npm cache clean --force; rm -rf /root/.npm; \
    claude --version; codex --version; opencode --version; pi --version; grok --version

# The server last, so a new Hub version rebuilds only these layers.
COPY modules/ /opt/t3/app/node_modules/
COPY server/ /opt/t3/app/
COPY extras/ /opt/t3/
RUN set -eu; \
    if [ -x /opt/t3/app/t3 ]; then \
      ln -s /opt/t3/app/t3 /usr/local/bin/t3; \
    else \
      printf '#!/bin/sh\nexec node /opt/t3/app/dist/bin.mjs "$@"\n' > /usr/local/bin/t3; \
      chmod 755 /usr/local/bin/t3; \
    fi; \
    t3 --version

# Last, so each build is an image of its own even when every layer above is cached (a `--label`
# alone does not make one on Podman 3.4). The Hub passes `<Hub version>-<UTC build time>`.
ARG T3_IMAGE_VERSION=unversioned
LABEL io.t3code.sandbox-image="1" io.t3code.image-version="${T3_IMAGE_VERSION}"
